# Copy to .env and adjust for your environment.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite is used when DATABASE_URL is empty. Production example:
# DATABASE_URL=postgres://studio:password@localhost:5432/studio
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
API_ANON_THROTTLE=120/min
API_SUBMISSION_THROTTLE=10/hour
